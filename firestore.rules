rules_version = '2';

// The Flask backend reads and writes Firestore through the Admin SDK, which
// bypasses these rules entirely. The browser only ever talks to Firebase
// Authentication, never to Firestore directly — so deny all client access.
//
// If you later add direct browser reads (e.g. a live leaderboard), replace the
// blanket deny with per-collection rules such as:
//   match /users/{uid} { allow read: if request.auth.uid == uid; }
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
